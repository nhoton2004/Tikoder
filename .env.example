# SECURITY CRITICAL - Must be set in production
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_strong_random_secret_here_min_32_chars

# Environment: development or production
NODE_ENV=development

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Authentication & Authorization
ALLOW_REGISTER=true
ADMIN_EMAILS=admin@example.com,superadmin@example.com

# Dev-only: Set to 'true' ONLY in development environment
# NEVER set to 'true' in production
VITE_DEV_SKIP_AUTH=false

# Printer Configuration
# Format: tcp://192.168.1.9 or usb://device
PRINTER_INTERFACE=tcp://192.168.1.9

# TikTok Live API
TIKTOK_SIGN_API_KEY=your_tiktok_api_key_here

# Server Port
PORT=3000

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Session Configuration
SESSION_TIMEOUT=86400000