# SECURITY CRITICAL - Must be set in production
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_strong_random_secret_here_min_32_chars

# Environment: development or production
NODE_ENV=development

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Authentication & Authorization
ALLOW_REGISTER=true
ADMIN_EMAILS=admin@example.com,superadmin@example.com

# Dev-only: Set to 'true' ONLY in development environment
# NEVER set to 'true' in production
VITE_DEV_SKIP_AUTH=false

# Printer Configuration
# Format: tcp://192.168.1.9 or usb://device
PRINTER_INTERFACE=tcp://192.168.1.9

# TikTok Live API
TIKTOK_SIGN_API_KEY=your_tiktok_api_key_here

# Server Port
PORT=3000

# n8n owner notifications: disabled until a secured workflow is configured
NOTIFY_ENABLED=false
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/tikoder/event
# Opt in only for a trusted private Docker network, e.g. http://n8n:5678.
N8N_INTERNAL_HTTP_ORIGIN=
N8N_HEADER_TOKEN=
N8N_NOTIFY_SECRET=
PUBLIC_APP_URL=http://localhost:3000/app

# Read-only Tikoder data API for the separate Zalo/n8n integration.
# Leave empty until the adapter and n8n workflow are approved for live use.
# Bind these three values to exactly one shop; never expose them to frontend code.
N8N_DATA_API_SECRET=
N8N_DATA_API_TENANT=
N8N_DATA_API_UID=

# Standalone unofficial personal-Zalo adapter. Keep disabled until live approval.
ZALO_PERSONAL_ALLOW_QR_LOGIN=false
ZALO_PERSONAL_CREDENTIALS_FILE=
ZALO_PERSONAL_QR_PATH=
ZALO_PERSONAL_STATE_FILE=
ZALO_PERSONAL_EVENT_URL=http://127.0.0.1:5678/webhook/tikoder/zalo-personal-event
ZALO_PERSONAL_EVENT_SECRET=
ZALO_PERSONAL_COMMAND_SECRET=
ZALO_PERSONAL_ADAPTER_PORT=3010

# Experimental local Zalo Web automation; only explicitly allowlisted test numbers
ZALO_WEB_EXPERIMENTAL=false
ZALO_TEST_PHONES=
ZALO_BROWSER_PATH=

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Session Configuration
SESSION_TIMEOUT=86400000

# Docker: local HTTP; production override sets NODE_ENV=production.
APP_PORT=3000
DOCKER_NODE_ENV=development
SESSION_STORE=sqlite
SESSION_DB_PATH=./data/sessions.sqlite
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
# Only trust the configured reverse proxy; leave empty for direct local access.
TRUST_PROXY=
# Required only for compose.production.yml (hostname without scheme or path).
APP_DOMAIN=
ZALO_PERSONAL_ADAPTER_HOST=127.0.0.1
