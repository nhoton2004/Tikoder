<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DebtTracker - Quản Lý Nợ Nần</title>
    <style>
        :root {
            --primary: #2563eb;
            --danger: #ef4444;
            --success: #22c55e;
            --warning: #f59e0b;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        h1 { margin: 0; color: var(--primary); }
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: var(--card);
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            text-align: center;
        }
        .stat-card h3 { margin: 0; font-size: 0.9rem; opacity: 0.7; }
        .stat-card p { margin: 10px 0 0; font-size: 1.5rem; font-weight: bold; }
        .total-debt { color: var(--danger); }

        .card {
            background: var(--card);
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            margin-bottom: 20px;
        }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: 500; }
        input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            box-sizing: border-box;
        }
        button {
            background: var(--primary);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }
        button:hover { opacity: 0.9; }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        th, td {
            text-align: left;
            padding: 12px;
            border-bottom: 1px solid #eee;
        }
        .status-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: bold;
        }
        .status-pending { background: #fee2e2; color: #991b1b; }
        .status-paid { background: #dcfce7; color: #166534; }
        .urgent { color: var(--danger); font-weight: bold; }

        .btn-sm {
            padding: 5px 10px;
            font-size: 0.8rem;
            margin-right: 5px;
            border-radius: 4px;
            cursor: pointer;
            border: none;
            color: white;
            font-weight: bold;
        }
        .pay-btn { background: var(--success); }
        .edit-btn { background: var(--warning); }
        .delete-btn { background: var(--danger); }
        
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
        }
        .modal-content {
            background: white;
            padding: 20px;
            border-radius: 12px;
            width: 400px;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>DebtTracker 💸</h1>
            <p>Chào Đại ca Nhớ!</p>
        </header>

        <div class="stats">
            <div class="stat-card">
                <h3>Tổng nợ hiện tại</h3>
                <p id="total-debt" class="total-debt">0đ</p>
            </div>
            <div class="stat-card">
                <h3>Khoản nợ sắp tới hạn</h3>
                <p id="urgent-count">0</p>
            </div>
        </div>

        <div class="card">
            <h2 id="form-title">Thêm khoản nợ mới</h2>
            <form id="debt-form">
                <input type="hidden" id="debt-id">
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 10px; align-items: end;">
                    <div class="form-group">
                        <label>Chủ nợ</label>
                        <input type="text" id="creditor" required placeholder="Nợ ai?">
                    </div>
                    <div class="form-group">
                        <label>Số tiền (VNĐ)</label>
                        <input type="number" id="amount" required placeholder="Bao nhiêu?">
                    </div>
                    <div class="form-group">
                        <label>Hạn trả</label>
                        <input type="date" id="due_date" required>
                    </div>
                    <div style="margin-bottom: 15px;">
                        <button type="submit" id="submit-btn">Thêm nợ</button>
                        <button type="button" id="cancel-btn" style="display:none; background:#64748b;">Hủy</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="card">
            <h2>Danh sách nợ nần</h2>
            <table id="debt-table">
                <thead>
                    <tr>
                        <th>Chủ nợ</th>
                        <th>Tiền nợ</th>
                        <th>Còn lại</th>
                        <th>Hạn chót</th>
                        <th>Cảnh báo</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="debt-list">
                    <!-- Dữ liệu sẽ load ở đây -->
                </tbody>
            </table>
        </div>
    </div>

    <script>
        let allDebts = [];

        async function loadDebts() {
            const res = await fetch('/api/debts');
            allDebts = await res.json();
            const list = document.getElementById('debt-list');
            list.innerHTML = '';
            
            let total = 0;
            let urgent = 0;

            allDebts.forEach(d => {
                if (d.status === 'pending') total += d.remaining_amount;
                
                const daysLeft = Math.ceil(d.days_left);
                let warning = '';
                if (d.status === 'pending') {
                    if (daysLeft < 0) warning = `<span class="urgent">QUÁ HẠN ${Math.abs(daysLeft)} NGÀY!</span>`;
                    else if (daysLeft <= 3) {
                        warning = `<span class="urgent">Còn ${daysLeft} ngày!</span>`;
                        urgent++;
                    }
                    else warning = `Còn ${daysLeft} ngày`;
                }

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${d.creditor}</td>
                    <td>${d.total_amount.toLocaleString()}đ</td>
                    <td style="font-weight: bold">${d.remaining_amount.toLocaleString()}đ</td>
                    <td>${d.due_date}</td>
                    <td>${d.status === 'paid' ? '<span class="status-badge status-paid">Đã xong</span>' : warning}</td>
                    <td>
                        <div style="display: flex;">
                            ${d.status === 'pending' ? `<button class="btn-sm pay-btn" onclick="payDebt(${d.id})">Trả</button>` : ''}
                            <button class="btn-sm edit-btn" onclick="editDebt(${d.id})">Sửa</button>
                            <button class="btn-sm delete-btn" onclick="deleteDebt(${d.id})">Xóa</button>
                        </div>
                    </td>
                `;
                list.appendChild(row);
            });

            document.getElementById('total-debt').innerText = total.toLocaleString() + 'đ';
            document.getElementById('urgent-count').innerText = urgent;
        }

        document.getElementById('debt-form').onsubmit = async (e) => {
            e.preventDefault();
            const id = document.getElementById('debt-id').value;
            const data = {
                creditor: document.getElementById('creditor').value,
                total_amount: Number(document.getElementById('amount').value),
                due_date: document.getElementById('due_date').value
            };
            
            const method = id ? 'PUT' : 'POST';
            const url = id ? `/api/debts/${id}` : '/api/debts';

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if (!response.ok) throw new Error('Thao tác thất bại!');
                
                cancelEdit();
                loadDebts();
                alert(id ? 'Đã cập nhật thông tin nợ!' : 'Đã thêm khoản nợ mới cho Đại ca!');
            } catch (err) {
                alert(err.message);
            }
        };

        function editDebt(id) {
            const debt = allDebts.find(d => d.id === id);
            if (!debt) return;

            document.getElementById('form-title').innerText = 'Sửa khoản nợ';
            document.getElementById('debt-id').value = debt.id;
            document.getElementById('creditor').value = debt.creditor;
            document.getElementById('amount').value = debt.total_amount;
            document.getElementById('due_date').value = debt.due_date;
            document.getElementById('submit-btn').innerText = 'Lưu thay đổi';
            document.getElementById('cancel-btn').style.display = 'inline-block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function cancelEdit() {
            document.getElementById('form-title').innerText = 'Thêm khoản nợ mới';
            document.getElementById('debt-id').value = '';
            document.getElementById('debt-form').reset();
            document.getElementById('submit-btn').innerText = 'Thêm nợ';
            document.getElementById('cancel-btn').style.display = 'none';
        }

        document.getElementById('cancel-btn').onclick = cancelEdit;

        async function deleteDebt(id) {
            if (!confirm('Đại ca chắc chắn muốn xóa khoản nợ này chứ? Xóa là mất luôn đó!')) return;

            try {
                const response = await fetch(`/api/debts/${id}`, { method: 'DELETE' });
                if (!response.ok) throw new Error('Xóa thất bại!');
                loadDebts();
                alert('Đã xóa xong!');
            } catch (err) {
                alert(err.message);
            }
        }

        async function payDebt(id) {
            const amount = prompt("Đại ca muốn trả bao nhiêu cho khoản này?");
            if (!amount || isNaN(amount)) return;

            try {
                const response = await fetch(`/api/debts/${id}/pay`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ amount_paid: Number(amount) })
                });
                if (!response.ok) throw new Error('Cập nhật khoản trả thất bại!');
                
                loadDebts();
                alert('Đã cập nhật số tiền trả. Chúc mừng Đại ca sắp hết nợ!');
            } catch (err) {
                alert(err.message);
            }
        }

        loadDebts();
    </script>
</body>
</html>
